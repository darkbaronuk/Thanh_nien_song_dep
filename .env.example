# Mat khau dang nhap trang quan tri
ADMIN_PASSWORD=dat-mat-khau-manh

# Thu muc luu co so du lieu va tep tai len
DATA_DIR=./data

# Nguon duoc phep goi API (ngan cach bang dau phay)
ALLOWED_ORIGINS=http://localhost:5000

# AI: vertex (Vertex AI) hoac gemini (Google AI Studio)
AI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-2.5-pro
# Chi dung khi AI_PROVIDER=gemini
GEMINI_API_KEY=

# Dia chi cong khai cua trang, dung de tao duong dan quay lai sau khi uy quyen
SITE_URL=http://localhost:5000

# OAuth ket noi Google Drive (pham vi drive.file)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:5000/api/admin/google/callback

# Thu muc goc tren Drive va danh sach thu dien tu duoc chia se
DRIVE_ROOT_NAME=Giai thuong Thanh nien song dep 2026
DRIVE_SHARE_EMAILS=
